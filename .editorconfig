# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,yaml,yml,css,scss,html,md}]
indent_size = 2

[Makefile]
indent_style = tab
