# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# Project: Hybrid AI-Powered Multilingual Plagiarism Detection and Analysis System
# ==============================================================================

# Force Production Mode
APP_RUNTIME_MODE=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://plagiarism-platform.onrender.com,https://yourdomain.com

# Managed PostgreSQL with pgvector
POSTGRES_USER=plagiarism_user
POSTGRES_PASSWORD=STRONG_PRODUCTION_POSTGRES_PASSWORD_REPLACE_ME
POSTGRES_DB=plagiarism_platform
POSTGRES_HOST=dpg-xxxxxx-a.oregon-postgres.render.com
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://plagiarism_user:STRONG_PRODUCTION_POSTGRES_PASSWORD_REPLACE_ME@dpg-xxxxxx-a.oregon-postgres.render.com:5432/plagiarism_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Managed Redis for RQ Background Worker
REDIS_HOST=red-xxxxxx.render.com
REDIS_PORT=6379
REDIS_URL=redis://default:STRONG_REDIS_PASSWORD@red-xxxxxx.render.com:6379
WORKER_QUEUE_NAME=default
JOB_TIMEOUT_SECONDS=600

# Persistent Private Object Storage
STORAGE_BACKEND=local
STORAGE_ROOT_DIR=/app/storage
LOCAL_PRIVATE_STORAGE_ROOT=/app/storage/private
MAX_UPLOAD_SIZE_BYTES=31457280

# Production JWT Authentication (Strictly enforced, dev user bypass disabled)
JWT_SECRET_KEY=GENERATE_HIGH_ENTROPY_MIN_64_CHAR_KEY_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Configuration (intfloat/multilingual-e5-small)
SEMANTIC_MODEL_NAME=intfloat/multilingual-e5-small
SEMANTIC_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
SEMANTIC_EMBEDDING_DIM=384
SEMANTIC_MAX_SEQ_LENGTH=512
SEMANTIC_DEVICE=cpu
SEMANTIC_PARAPHRASE_THRESHOLD=0.82
SEMANTIC_TRANSLATION_THRESHOLD=0.80

# Headless Chromium for PDF Reports
CHROMIUM_PATH=/usr/bin/chromium
